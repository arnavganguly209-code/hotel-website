# Orbit CMS (server-side only)
ORBIT_ADMIN_PASSWORD=your-secure-key-here

# Admin PMS (/admin) — session signing secret (required in production)
# ADMIN_SESSION_SECRET=long-random-string
# Optional override for first-boot password (default is set server-side only)
# ADMIN_BOOTSTRAP_PASSWORD=

# PostgreSQL on the Hostinger VPS ONLY — localhost database "thamelpark"
# Remote / hosted database URLs are rejected by the app and deploy scripts.
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/thamelpark?schema=public

# Public site URL — use http:// during testing; switch to https:// after SSL
NEXT_PUBLIC_SITE_URL=http://YOUR_VPS_IP_OR_DOMAIN
SITE_URL=http://YOUR_VPS_IP_OR_DOMAIN

# Orbit local uploads (absolute path on Hostinger VPS). Served by /uploads/* route.
# UPLOADS_ROOT=/var/www/hotel-website/public/uploads

# Cookie security:
# - HTTP testing: COOKIE_SECURE=false (or leave unset with http:// SITE_URL)
# - After HTTPS (Nginx TLS): COOKIE_SECURE=true  OR  set SITE_URL to https://...
# COOKIE_SECURE=false
# TRUST_PROXY_HTTPS=true

# Contact enquiry emails (optional — enquiries still save to DB without SMTP)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=booking@hotelthamelpark.com
# SMTP_PASSWORD=your-smtp-password
# Legacy alias still accepted: SMTP_PASS=
# MAIL_FROM_NAME=Hotel Thamel Park
# MAIL_FROM_ADDRESS=booking@hotelthamelpark.com
# HOTEL_NAME=Hotel Thamel Park
# HOTEL_PHONE=+977-1-4412345
# HOTEL_EMAIL=booking@hotelthamelpark.com
# HOTEL_ADDRESS=Thamel, Kathmandu 44600, Nepal
# HOTEL_WEBSITE=https://hotel.theglobalorbit.com
# HOTEL_GOOGLE_MAP=https://maps.google.com/?q=Hotel+Thamel+Park+Kathmandu
# HOTEL_WHATSAPP=+9779841234567
# BOOKING_NOTIFY_EMAIL=booking@hotelthamelpark.com
# HOTEL_CHECKIN_TIME=14:00
# HOTEL_CHECKOUT_TIME=12:00
# HOTEL_SMOKING_POLICY=
# HOTEL_CANCELLATION_POLICY=
# HOTEL_CHILDREN_POLICY=
# HOTEL_EXTRA_BED_POLICY=
# ---------------------------------------------------------------------------
# Himalayan Bank PACO (2C2P) — UAT / Production (server-side only)
# Never put these in NEXT_PUBLIC_*. Never commit real values.
# ---------------------------------------------------------------------------
# Production (live VPS):
# HBL_PACO_ENV=production
# HBL_PACO_OFFICE_ID=9104539176
# HBL_PACO_API_KEY=
# HBL_PACO_ENCRYPTION_KEY_ID=19f84b5655f04e25a99b09f1ee2fac78
# HBL_PACO_BASE_URL=https://core.paco.2c2p.com/
# UAT (local / dedicated tests only):
# HBL_PACO_ENV=uat
# HBL_PACO_OFFICE_ID=9104137120
# HBL_PACO_ENCRYPTION_KEY_ID=7664a2ed0dee4879bdfca0e8ce1ac313
# HBL_PACO_BASE_URL=https://core.demo-paco.2c2p.com/
# HBL_PACO_REQUEST_3DS=Y
# Settlement currency fallback ONLY when a caller omits currency.
# Live /api/bookings always sends the booking currency (default USD).
# Production must be USD.
# HBL_PACO_CURRENCY=USD
# Optional site-wide booking settlement mode (USD default). Do NOT set to NPR
# unless the hotel intentionally sells in NPR. Independent of HBL_PACO_CURRENCY.
# BOOKING_CURRENCY=USD
# NEVER set HBL_PACO_SDK_DEMO_SHAPE — demo sample shape is opt-in via code for
# UAT scripts only (scripts/_hbl-sdk-npr1-uat.ts). Production rejects it.
# Keys: paste bare base64 (no PEM headers), or full PEM with \n for newlines.
# Merchant signing private = signs outbound JWS.
# Merchant decryption private = decrypts PACO responses (encryption key pair).
# PACO encryption/signing publics belong to HBL — do not replace with merchant publics.
# HBL_PACO_MERCHANT_SIGNING_PRIVATE_KEY=
# HBL_PACO_PACO_ENCRYPTION_PUBLIC_KEY=
# HBL_PACO_PACO_SIGNING_PUBLIC_KEY=
# HBL_PACO_MERCHANT_DECRYPTION_PRIVATE_KEY=

